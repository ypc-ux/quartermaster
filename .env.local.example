# Quartermaster env (local, not committed)
# Search for Research Agent — paste a fresh key from https://serper.dev (free 2500 searches)
# Leave commented to run agents in offline mode
# SERPER_API_KEY=<set>

# Optional: resolves GitHub rate limits for the Whiteboard repo visualizer (60/hr unauth)
# GITHUB_TOKEN=<set>

# Optional: elevates command output to LLM-generated copy (Anthropic or OpenAI)
# ANTHROPIC_API_KEY=<set>
# OPENAI_API_KEY=<set>

# Optional: persist tasks/testimonials (Mode: Supabase free tier)
# SUPABASE_URL=<set>
# SUPABASE_ANON_KEY=<set>

# Optional: twitter posting (tweepy)
# TWITTER_BEARER_TOKEN=<set>
# TWITTER_API_KEY=<set>
# TWITTER_API_SECRET=<set>
# TWITTER_ACCESS_TOKEN=<set>
# TWITTER_ACCESS_SECRET=<set>
